{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MutaliaMember",
  "type": "object",
  "required": [
    "member_id",
    "first_name",
    "last_name",
    "birth_date",
    "role"
  ],
  "properties": {
    "member_id": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "birth_date": {
      "type": "string",
      "format": "date"
    },
    "role": {
      "enum": [
        "adherent",
        "conjoint",
        "enfant"
      ]
    },
    "household_id": {
      "type": "string"
    },
    "synthetic": {
      "const": true
    }
  }
}